{:source-paths ["src/cljs"]
 :dependencies
 [[metosin/malli "0.16.4"]
  [funcool/promesa "11.0.678"]
  [com.github.seancorfield/honeysql "2.7.1368"]]
 :nrepl {:port 4600}
 :js-options {:js-provider :import}
 :builds
 {:server
  {:target :esm
   :runtime :node
   :output-dir "dist"
   :modules {:server {:init-fn axxium.server/start!}}
   :js-options
   {:js-provider :import
    :keep-as-import
    #{"fastify"
      "@fastify/cookie"
      "@fastify/cors"
      "@fastify/static"
      "bcrypt"
      "jose"
      "pg"
      "node:crypto"
      "node:fs"
      "node:path"
      "node:url"}}
   :compiler-options
   {:output-feature-set :es-next
    :optimizations :simple
    :source-map true
    :infer-externs false}}

  :server-dev
  {:target :esm
   :runtime :node
   :output-dir "dist-dev"
   :modules {:server {:init-fn axxium.server/start!}}
   :js-options
   {:js-provider :import
    :keep-as-import
    #{"fastify"
      "@fastify/cookie"
      "@fastify/cors"
      "@fastify/static"
      "bcrypt"
      "jose"
      "pg"
      "node:crypto"
      "node:fs"
      "node:path"
      "node:url"}}
   :devtools
   {:autoload true
    :preloads [shadow.cljs.devtools.client.node-esm]
    :ignore-warnings true}
   :compiler-options
   {:output-feature-set :es-next
    :optimizations :none
    :source-map true
    :infer-externs false}}

  :oidc-store-fixture
  {:target :esm :runtime :node
   :output-dir "target/oidc-store"
   :js-options {:js-provider :import}
   :modules {:store {:exports {:initialize axxium.extern.oidc-store/initialize!
                              :adapterFactory axxium.extern.oidc-store/adapter-factory
                              :createProvider axxium.extern.oidc-fixture/create-provider
                              :bindSession axxium.extern.oidc-store/bind-session!
                              :sessionGrantActive axxium.extern.oidc-store/session-grant-active?
                              :installHttp axxium.extern.oidc-fixture/install-http}}}
   :compiler-options {:output-feature-set :es-next :optimizations :simple :infer-externs false}}

  :lifecycle-fixture
  {:target :esm :runtime :node
   :output-dir "target/lifecycle"
   :modules {:lifecycle {:exports {:install axxium.extern.lifecycle/install!
                                    :attach axxium.extern.lifecycle/attach!
                                    :closeStartup axxium.extern.lifecycle/close-startup!
                                    :stopping axxium.extern.lifecycle/stopping?}}}
   :compiler-options {:output-feature-set :es-next :optimizations :simple :infer-externs false}}

  :test
  {:target :node-test
   :output-to "target/test.cjs"
   :ns-regexp "axxium\\..*-test$"
   :autorun true
   :compiler-options
   {:output-feature-set :es-next
    :infer-externs false}}}}
