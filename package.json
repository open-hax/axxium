    "boundary:check": "node scripts/check-js-boundary.mjs --check",
    "test:oidc-store": "shadow-cljs release oidc-store-fixture && node scripts/oidc-store.integration.mjs",
    "test:oidc-protocol": "shadow-cljs release oidc-store-fixture && node scripts/oidc-device.inject.mjs"
  },
  "dependencies": {
    "@atproto-labs/simple-store-memory": "^0.2.6",
