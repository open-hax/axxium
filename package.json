    "@atproto/oauth-client-node": "^0.5.8",
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^10.0.1",
    "@fastify/static": "^10.1.5",
    "bcryptjs": "^3.0.3",
    "fastify": "^5.12.5",
    "ipaddr.js": "^2.5.0",
    "jose": "^5.9.3",
    "oidc-provider": "9.13.0",
    "pg": "^8.16.3",
    "shadow-cljs": "^3.3.5"
  }
