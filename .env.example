# Axxium Identity Provider Configuration

# Server
AXXIUM_PORT=8787
AXXIUM_HOST=0.0.0.0
AXXIUM_PUBLIC_BASE_URL=http://127.0.0.1:8787

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=axxium
DB_USER=axxium
DB_PASSWORD=axxium_password

# Ed25519 signing key. Provision with:
#   node scripts/provision-signing-key.mjs ./signing-key.pem
# The script writes mode 0600 and prints the kid and public JWK only.
AXXIUM_SIGNING_KEY_FILE=./signing-key.pem
# Optional. Unset uses the RFC 7638 SHA-256 thumbprint of {kty,crv,x}.
# AXXIUM_SIGNING_KID=
JWT_ISSUER=axxium
# aud is AXXIUM_SERVICE+AXXIUM_ENV (promethean+development below).
# Leave JWT_AUDIENCE unset. The old value promethean is rejected at startup.
AXXIUM_SERVICE=promethean
AXXIUM_ENV=development
JWT_EXPIRY_HOURS=168

# Session
SESSION_COOKIE_NAME=axxium_session
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAME_SITE=lax

# Password hashing
BCRYPT_SALT_ROUNDS=12

# OAuth (optional)
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_ENABLED=false
